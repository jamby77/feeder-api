@url = http://localhost:5555

### GET home
GET {{ url }}

### GET info
GET {{ url }}/info

### GET config
GET {{ url }}/config

### POST config
POST {{ url }}/config
Content-Type: application/json

{
  "title": "test",
  "refreshInterval": 600,
  "shortcuts": [
    {
      "key": "j",
      "title": "Next",
      "command": "next"
    }
  ]
}

### GET feeds
GET {{ url }}/feeds

### POST feed
POST {{ url }}/feeds
Content-Type: application/json

{
  "categories": [
    "programming",
    "random"
  ],
  "htmlUrl": "https://akrabat.com",
  "id": "https://akrabat.com/feed/",
  "lastUpdated": "2024-07-02T21:24:53.000Z",
  "text": "Rob Allen!",
  "title": "Rob Allen",
  "type": "rss",
  "xmlUrl": "https://akrabat.com/feed/"
}

### PUT feed
PUT {{ url }}/feeds
Content-Type: application/json

{
  "categories": [
    "programming",
    "random",
    "other"
  ],
  "htmlUrl": "https://akrabat.com",
  "id": "https://akrabat.com/feed/",
  "lastUpdated": "2024-07-02T21:24:53.000Z",
  "text": "Rob Allen!",
  "title": "Rob Allen",
  "type": "rss",
  "xmlUrl": "https://akrabat.com/feed/"
}

### GET feed/details
< {%
  const feeds = [
    "http://www.phpdeveloper.org/feed",
    "http://feeds.feedburner.com/jetbrains_intellijidea",
    "https://akrabat.com/feed/",
    "https://blog.jetbrains.com/go/feed/",
    "https://blog.jetbrains.com/phpstorm/feed/",
    "https://blog.jetbrains.com/webstorm/feed/",
    "https://reactjs.org/feed.xml",
    "https://vercel.com/atom",
    "https://www.moreto.net/rss/lastnews.xml",
    'https://www.engadget.com/rss.xml',
  ]
  // const feedUrl = feeds[0];
  const feedUrl = feeds[Math.floor(Math.random() * feeds.length)];
  console.log({ feedUrl });
  request.variables.set("feedUrl", feedUrl)
%}
GET {{ url }}/feed/details?feed={{feedUrl}}

### GET feed/details total count
GET {{ url }}/feed/details/count?feed=https://akrabat.com/feed/

### GET feed/details unread count
GET {{ url }}/feed/details/count?feed=https://akrabat.com/feed/&unread=true

### GET feed/details all feeds count
GET {{ url }}/feed/details/count

### GET feed/details all feeds count unread
GET {{ url }}/feed/details/count?unread=true

### GET feed items
GET {{ url }}/feed/items?feed=https://akrabat.com/feed/

### GET unread feed items
GET {{ url }}/feed/items?feed=https://akrabat.com/feed/&unread=true

### PUT mark feed item as read
PUT {{ url }}/feed/items/read?feed=https://akrabat.com/feed/&
    feedItem=https://akrabat.com/converting-a-phpunit-testlistener-to-an-event-subscriber/

### PUT mark feed item as read BAD
PUT {{ url }}/feed/items/read?feed=https://akrabat.com/feed/

### PUT mark all feed items as read
PUT {{ url }}/feed/items/read?feed=https://akrabat.com/feed/

### PUT mark all feed items as un-read
PUT {{ url }}/feed/items/un-read?feed=https://akrabat.com/feed/

### GET refresh feed
GET {{ url }}/refresh?feed=https://akrabat.com/feed/
